# Never commit .env. Only .env.example belongs in git.
OPENAI_API_KEY=

# Hard cap on images generated per run. Raise deliberately, never in a loop.
MAX_IMAGES_PER_RUN=10
IMAGE_MODEL=gpt-image-2

# snap.mjs
SNAP_BASE_URL=http://localhost:3000
SNAP_ROUTES=/
SNAP_SRC=src,app,components,styles
# Routes volontairement inexistantes dans SNAP_ROUTES (pour auditer le vrai
# rendu 404) — leur 404 de ressource ne compte pas comme échec du gate.
SNAP_EXPECT_404=
