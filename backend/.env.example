# Copie ce fichier en .env et renseigne les vraies valeurs avant la mise en production.
# Aucune valeur ci-dessous n'est un secret reel.

# --- Base de donnees ---
DATABASE_URL="postgresql://wcr:wcr@localhost:5432/wcr_belgium?schema=public"

# --- Serveur ---
PORT=3000
NODE_ENV=development
PUBLIC_BASE_URL="http://localhost:3000"
ADMIN_SESSION_SECRET="change-me-dev-only"
ORDER_TRACKING_TOKEN_SECRET="change-me-dev-only"

# --- Mollie (TODO A CONFIRMER: compte Mollie reel) ---
# Cle de test fournie par Mollie (mode sandbox) : commence par "test_"
MOLLIE_API_KEY="test_placeholder"
MOLLIE_WEBHOOK_URL="http://localhost:3000/api/webhooks/mollie"

# --- E-mail transactionnel (TODO A CONFIRMER: compte Resend/Postmark reel) ---
RESEND_API_KEY="re_placeholder"
EMAIL_FROM="WC Rent Belgium <commandes@wcrentbelgium.be>"
EMAIL_INTERNAL_NOTIFY="operations@wcrentbelgium.be"

# --- Anti-spam ---
HCAPTCHA_SECRET="hcaptcha_placeholder"

# --- Entreprise (TODO A CONFIRMER: coordonnees legales reelles) ---
COMPANY_NAME="WC Rent Belgium SRL"
COMPANY_VAT="BE 0000.000.000"
COMPANY_ADDRESS="Adresse a confirmer, Belgique"
